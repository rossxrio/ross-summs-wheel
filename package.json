{
  "name": "ross-summs-wheel",
  "private": true,
  "version": "1.0.0-beta",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests index.html settings.html && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "icons": "tauri icon src-tauri/icons/app-icon.svg",
    "test": "node --test tests/*.test.ts && cargo test --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
